	chapter.A500000000000005.title: "За гранью"

	quest.B101000000000001.title: "С чего-то надо начать"
	quest.B101000000000001.quest_subtitle: "Первый рабочий стол"
	quest.B101000000000001.quest_desc: ["Собери верстак. Meridian не требует предыстории — мир уже здесь, а выживать придётся тебе."]
	quest.B101000000000002.title: "Камень под рукой"
	quest.B101000000000002.quest_subtitle: "Простейший инструмент"
	quest.B101000000000002.quest_desc: ["Сделай каменную кирку и начни добычу ресурсов."]
	quest.B101000000000003.title: "Первый жар"
	quest.B101000000000003.quest_subtitle: "Печь"
	quest.B101000000000003.quest_desc: ["Поставь печь. Дальше мир будет требовать всё больше металла."]
	quest.B101000000000004.title: "Железный запас"
	quest.B101000000000004.quest_subtitle: "8 слитков железа"
	quest.B101000000000004.quest_desc: ["Собери первый запас железа для инструментов и механизмов."]
	quest.B101000000000005.title: "Медь"
	quest.B101000000000005.quest_subtitle: "8 медных слитков"
	quest.B101000000000005.quest_desc: ["Медь понадобится почти во всей технологической ветке Meridian."]
	quest.B101000000000006.title: "Точка опоры"
	quest.B101000000000006.quest_subtitle: "Обустрой постоянное место"
	quest.B101000000000006.quest_desc: ["Сделай место, которое уже можно назвать базой. Отсюда начнётся настоящая прогрессия."]
	task.C101000000000006.title: "База готова"

	quest.B201000000000001.title: "Кузница"
	quest.B201000000000001.quest_subtitle: "Собери рабочую металлургическую установку"
	quest.B201000000000001.quest_desc: ["Пора уходить от обычной печи. Собери кузницу Meridian и подготовь её к работе."]
	task.C201000000000001.title: "Кузница собрана"
	quest.B201000000000002.title: "HV3000"
	quest.B201000000000002.quest_subtitle: "Запусти нагрев"
	quest.B201000000000002.quest_desc: ["Подключи и запусти нагреватель HV3000. Без стабильного жара расплава не будет."]
	task.C201000000000002.title: "Нагреватель запущен"
	quest.B201000000000003.title: "Первый расплав"
	quest.B201000000000003.quest_subtitle: "Расплавь металл"
	quest.B201000000000003.quest_desc: ["Получи первый полноценный расплав в тигле."]
	task.C201000000000003.title: "Расплав получен"
	quest.B201000000000004.title: "Литьё"
	quest.B201000000000004.quest_subtitle: "Используй форму"
	quest.B201000000000004.quest_desc: ["Отлей деталь через носик и форму. Теперь металл можно не только плавить, но и формовать."]
	task.C201000000000004.title: "Первая отливка готова"
	quest.B201000000000005.title: "Сплав"
	quest.B201000000000005.quest_subtitle: "Смешай металлы"
	quest.B201000000000005.quest_desc: ["Создай первый сплав в кузнице. Это открывает путь к более серьёзным материалам."]
	task.C201000000000005.title: "Первый сплав создан"
	quest.B201000000000006.title: "Оружейное литьё"
	quest.B201000000000006.quest_subtitle: "Отлей полноценное оружие"
	quest.B201000000000006.quest_desc: ["Используй крупную форму и создай оружие литьём. Металлургическая ветка считается освоенной."]
	task.C201000000000006.title: "Оружие отлито"

	quest.B301000000000001.title: "Инструмент инженера"
	quest.B301000000000001.quest_subtitle: "Гаечный ключ Create"
	quest.B301000000000001.quest_desc: ["Сделай гаечный ключ. Дальше механизмов будет много."]
	quest.B301000000000002.title: "Передача движения"
	quest.B301000000000002.quest_subtitle: "Шестерни"
	quest.B301000000000002.quest_desc: ["Собери запас шестерён и начни строить механическую сеть."]
	quest.B301000000000003.title: "Механический пресс"
	quest.B301000000000003.quest_subtitle: "Первый производственный узел"
	quest.B301000000000003.quest_desc: ["Поставь механический пресс и подготовься к серийному производству."]
	quest.B301000000000004.title: "Механический миксер"
	quest.B301000000000004.quest_subtitle: "Смешивание и переработка"
	quest.B301000000000004.quest_desc: ["Добавь к производству механический миксер."]
	quest.B301000000000005.title: "Автоматическая линия"
	quest.B301000000000005.quest_subtitle: "Соедини процессы"
	quest.B301000000000005.quest_desc: ["Свяжи несколько машин в одну работающую линию. Ручная перекладка предметов больше не считается автоматизацией."]
	task.C301000000000005.title: "Линия работает автоматически"
	quest.B301000000000006.title: "Инфраструктура"
	quest.B301000000000006.quest_subtitle: "Производство становится системой"
	quest.B301000000000006.quest_desc: ["Построй устойчивую сеть производства и транспорта. Теперь база — уже не просто набор машин."]
	task.C301000000000006.title: "Инфраструктура запущена"

	quest.B401000000000001.title: "Специализация"
	quest.B401000000000001.quest_subtitle: "Выбери профессию"
	quest.B401000000000001.quest_desc: ["Определи, чем твой персонаж будет полезен поселению. Профессия не задаёт твою историю — только специализацию."]
	task.C401000000000001.title: "Профессия выбрана"
	quest.B401000000000002.title: "Комплект I"
	quest.B401000000000002.quest_subtitle: "Базовое снаряжение профессии"
	quest.B401000000000002.quest_desc: ["Собери первый уровень профессионального комплекта."]
	task.C401000000000002.title: "Комплект I собран"
	quest.B401000000000003.title: "Комплект II"
	quest.B401000000000003.quest_subtitle: "Усиленное снаряжение"
	quest.B401000000000003.quest_desc: ["Перейди ко второму уровню профессионального комплекта."]
	task.C401000000000003.title: "Комплект II собран"
	quest.B401000000000004.title: "Комплект III"
	quest.B401000000000004.quest_subtitle: "Технологический уровень"
	quest.B401000000000004.quest_desc: ["Собери третий уровень. С этого момента экипировка уже должна заметно менять возможности профессии."]
	task.C401000000000004.title: "Комплект III собран"
	quest.B401000000000005.title: "Комплект IV"
	quest.B401000000000005.quest_subtitle: "Предельная специализация"
	quest.B401000000000005.quest_desc: ["Создай четвёртый уровень профессионального комплекта."]
	task.C401000000000005.title: "Комплект IV собран"

	quest.B501000000000001.title: "Защита от Незера"
	quest.B501000000000001.quest_subtitle: "Кольцо допуска"
	quest.B501000000000001.quest_desc: ["Подготовь кольцо защиты. Без него переход в Незер закрыт."]
	quest.B501000000000002.title: "Незер"
	quest.B501000000000002.quest_subtitle: "Первый переход"
	quest.B501000000000002.quest_desc: ["Войди в Незер после подготовки. Это первая настоящая смена этапа мира."]
	quest.B501000000000003.title: "Пламя"
	quest.B501000000000003.quest_subtitle: "Стержни ифрита"
	quest.B501000000000003.quest_desc: ["Добудь стержни ифрита. Они понадобятся для движения к Краю."]
	quest.B501000000000004.title: "Двенадцать глаз"
	quest.B501000000000004.quest_subtitle: "Подготовь портал"
	quest.B501000000000004.quest_desc: ["Собери 12 глаз Эндера. Путь к Краю должен оставаться осознанным этапом, а не случайным прыжком."]
	quest.B501000000000005.title: "Защита от Края"
	quest.B501000000000005.quest_subtitle: "Второе кольцо допуска"
	quest.B501000000000005.quest_desc: ["Подготовь кольцо защиты для Края."]
	quest.B501000000000006.title: "Край"
	quest.B501000000000006.quest_subtitle: "Следующий горизонт"
	quest.B501000000000006.quest_desc: ["Войди в Край. Основная технологическая прогрессия мира достигла следующего этапа."]
}
